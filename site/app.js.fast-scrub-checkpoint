);

forecastScrubber.addEventListener(
    "input",
    () => {

        if (
            !state.selectionFiles
            ||
            state.selectionFiles.length
            ===
            0
        ) {

            return;
        }

        stopAnimation();

        const index =
            Math.max(
                0,
                Math.min(
                    state.selectionFiles.length - 1,
                    Number(
                        forecastScrubber.value
                    )
                )
            );

        state.frameIndex =
            index;

        state.forecastHour =
            Number(
                state.selectionFiles[
                    index
                ].forecast_hour
            );

        renderCurrentFrame();
    }
);




/* ==========================================================
 * MASSACHUSETTSWX CYCLONE MANIFEST ADAPTER
 *
 * FNV3 / FNV3-L running-cycle progress.json uses a slightly
 * different shape from the conventional GFS/IFS/AIFS
 * manifest.
 *
 * Adapt it here so the existing viewer continues to use:
 *
 *     model
 *       -> cycle
 *       -> product
 *       -> region
 *       -> forecast hour
 *
 * No separate cyclone viewer is required.
 * ========================================================== */


function masswxIsCycloneModelId(
    modelId
) {

    return (
        modelId === "fnv3"
        ||
        modelId === "fnv3_large"
    );
}


function masswxNormalizeCycloneFile(
    file
) {

    if (
        typeof file === "string"
    ) {

        const match =
            file.match(
                /\/([^/]+)\/([^/]+)\/f([0-9]+)\.png$/
            );

        if (!match) {

            return {
                object: file,
                object_name: file,
                path: file,
            };
        }

        return {
            object: file,
            object_name: file,
            path: file,

            product:
                masswxCanonicalCycloneProduct(
                    match[1]
                ),

            source_product:
                match[1],

            region:
                match[2],

            forecast_hour:
                Number(
                    match[3]
                ),

            forecastHour:
                Number(
                    match[3]
                ),
        };
    }


    const objectName =
        file.object
        ||
        file.object_name
        ||
        file.path
        ||
        file.key
        ||
        file.url
        ||
        null;


    const forecastHour =
        Number(
            file.forecast_hour
            ??
            file.forecastHour
            ??
            file.hour
            ??
            0
        );


    const sourceProduct =
        file.product;

    const canonicalProduct =
        masswxCanonicalCycloneProduct(
            sourceProduct
        );

    return {
        ...file,

        object:
            objectName,

        object_name:
            objectName,

        path:
            objectName,

        product:
            canonicalProduct,

        source_product:
            sourceProduct,

        region:
            file.region,

        forecast_hour:
            forecastHour,

        forecastHour:
            forecastHour,
    };
}


function masswxAdaptCycloneManifest(
    modelId,
    raw
) {

    if (
        !masswxIsCycloneModelId(
            modelId
        )
        ||
        !raw
        ||
        typeof raw !== "object"
    ) {

        return raw;
    }


    /*
     * Completed cycles published through shared.publish already
     * look very similar to atmospheric manifests. Preserve them
     * and only normalize file entries.
     */

    const files =
        Array.isArray(
            raw.files
        )
            ?
            raw.files.map(
                masswxNormalizeCycloneFile
            )
            :
            [];


    let forecastHours =
        raw.available_forecast_hours
        ||
        raw.forecast_hours
        ||
        raw.completed_forecast_hours
        ||
        [];


    if (
        !Array.isArray(
            forecastHours
        )
        ||
        forecastHours.length === 0
    ) {

        forecastHours =
            Array.from(
                new Set(
                    files
                    .map(
                        file =>
                            Number(
                                file.forecast_hour
                            )
                    )
                    .filter(
                        Number.isFinite
                    )
                )
            )
            .sort(
                (a, b) =>
                    a - b
            );
    }


    let products =
        Array.isArray(
            raw.products
        )
            ?
            raw.products
            :
            [];


    if (
        products.length === 0
    ) {

        products =
            Array.from(
                new Set(
                    files
                    .map(
                        file =>
                            file.product
                    )
                    .filter(
                        Boolean
                    )
                )
            );
    }


    let regions =
        Array.isArray(
            raw.regions
        )
            ?
            raw.regions
            :
            [];


    if (
        regions.length === 0
    ) {

        regions =
            Array.from(
                new Set(
                    files
                    .map(
                        file =>
                            file.region
                    )
                    .filter(
                        Boolean
                    )
                )
            );
    }


    return {
        ...raw,

        model:
            modelId,

        files:
            files,

        products:
            products,

        regions:
            regions,

        forecast_hours:
            forecastHours,

        available_forecast_hours:
            forecastHours,

        file_count:
            raw.file_count
            ??
            files.length,
    };
}


/*
 * Wrap the existing manifest loader instead of replacing the
 * GFS/IFS/AIFS implementation.
 */

if (
    typeof loadRawManifest === "function"
) {

    const masswxOriginalLoadRawManifest =
        loadRawManifest;


    loadRawManifest =
        async function (
            modelId
        ) {

            const raw =
                await masswxOriginalLoadRawManifest(
                    modelId
                );


            return (
                masswxAdaptCycloneManifest(
                    modelId,
                    raw
                )
            );
        };
}


