// ============================================================
// FAST MAP SCRUBBING
// ============================================================

let mapImageRequestId = 0;

const mapPreloadCache =
    new Map();

const MAP_PRELOAD_RADIUS = 2;


function preloadMapUrl(
    url
) {

    if (
        !url
        ||
        mapPreloadCache.has(
            url
        )
    ) {
        return;
    }

    const image =
        new Image();

    mapPreloadCache.set(
        url,
        image
    );

    image.src =
        url;

    // Bound the cache so long sessions do not retain every
    // forecast image indefinitely.

    if (
        mapPreloadCache.size
        >
        12
    ) {

        const oldest =
            mapPreloadCache.keys().next().value;

        mapPreloadCache.delete(
            oldest
        );
    }
}


function preloadNearbyFrames() {

    if (
        !state.selectionFiles
        ||
        !state.selectionFiles.length
    ) {
        return;
    }

    for (
        let offset =
            -MAP_PRELOAD_RADIUS;
        offset
        <=
        MAP_PRELOAD_RADIUS;
        offset += 1
    ) {

        if (
            offset === 0
        ) {
            continue;
        }

        const index =
            state.frameIndex
            +
            offset;

        if (
            index < 0
            ||
            index
            >=
            state.selectionFiles.length
        ) {
            continue;
        }

        preloadMapUrl(
            state.selectionFiles[
                index
            ].url
        );
    }
}


function renderCurrentFrame() {

    if (
        !state.selectionFiles
        ||
        state.selectionFiles.length
        ===
        0
    ) {

        renderNoData(
            "No forecast frames available for this selection."
        );

        return;
    }

    if (
        state.frameIndex
        <
        0
    ) {

        state.frameIndex =
            0;
    }

    if (
        state.frameIndex
        >=
        state.selectionFiles.length
    ) {

        state.frameIndex =
            state.selectionFiles.length
            -
            1;
    }

    const current =
        state.selectionFiles[
            state.frameIndex
        ];

    state.forecastHour =
        Number(
            current.forecast_hour
        );

    // ========================================================
    // FAST FRAME SWAP
    //
    // Keep the currently displayed map visible while the next
    // forecast frame loads. Only swap after the browser has
    // successfully loaded the requested image.
    //
    // A monotonically increasing request ID prevents an older,
    // slower request from overwriting a newer slider position.
    // ========================================================

    const requestId =
        ++mapImageRequestId;

    const requestedUrl =
        current.url;

    const preload =
        new Image();

    preload.onload =
        () => {

            if (
                requestId
                !==
                mapImageRequestId
            ) {
                return;
            }

            mapImage.onload =
                null;

            mapImage.onerror =
                null;

            mapImage.src =
                requestedUrl;

            mapImage.style.display =
                "block";

            loadingText.style.display =
                "none";

            preloadNearbyFrames();
        };

    preload.onerror =
        () => {

            if (
                requestId
                !==
                mapImageRequestId
            ) {
                return;
            }

            // Keep the previous valid map visible.
            // Do not blank the viewer during normal scrubbing.

            loadingText.style.display =
                "none";
        };

    preload.src =
        requestedUrl;

    mapImage.alt =
        (
            getDisplayModelName()
            +
            " "
            +
            formatProductName(
                current.product
            )
            +
            " "
            +
            formatRegionName(
                current.region
            )
            +
            " "
            +
            formatForecastHour(
                current.forecast_hour
            )
        );

    updateFrameInformation();

    updateNavigationButtons();

    syncForecastScrubber();

    renderHourGrid();
}


function previousFrame() {

    if (
        !state.selectionFiles
        ||
        state.selectionFiles.length
        ===
        0
    ) {

        return;
    }

    state.frameIndex -=
        1;

    if (
        state.frameIndex
        <
        0
    ) {

        state.frameIndex =
            state.selectionFiles.length
            -
            1;
    }

    renderCurrentFrame();
}


function nextFrame() {

    if (
        !state.selectionFiles
        ||
        state.selectionFiles.length
        ===
        0
    ) {

        return;
    }

    state.frameIndex +=
        1;

    if (
        state.frameIndex
        >=
        state.selectionFiles.length
    ) {

        state.frameIndex =
            0;
    }

    renderCurrentFrame();
}


function animationDelay() {

    const value =
        Number(
            speedSelect.value
        );

    if (
        Number.isFinite(
            value
        )
        &&
        value
        >
        0
    ) {

        return value;
    }

    return 800;
}


function stopAnimation() {

    if (
        state.animationTimer
    ) {

        clearInterval(
            state.animationTimer
        );

        state.animationTimer =
            null;
    }

    state.playing =
        false;

    playButton.textContent =
        "▶ Play";
}


function startAnimation() {

    if (
        !state.selectionFiles
        ||
        state.selectionFiles.length
        <=
        1
    ) {

        return;
    }

    stopAnimation();

    state.playing =
        true;

    playButton.textContent =
        "❚❚ Pause";

    state.animationTimer =
        setInterval(
            () => {

                nextFrame();

            },
            animationDelay()
        );
}


function toggleAnimation() {

    if (
        state.playing
    ) {

        stopAnimation();
    }

    else {

        startAnimation();
    }
}


async function loadModel(
    modelId,
    {
        preserveSelection = false,
    } = {}
) {

    stopAnimation();

    state.modelId =
        modelId;

    modelSelect.value =
        modelId;

    loadingText.style.display =
        "flex";

    loadingText.textContent =
        (
            "Loading "
            +
            getDisplayModelName()
            +
            "..."
        );

    mapImage.style.display =
        "none";

    availabilityBadge.textContent =
        "Loading";

    availabilityBadge.className =
        "availability-badge loading";

    try {

        state.archiveCycles =
            await loadArchiveCycles(
                modelId
            );

        populateCycleSelect();

        const rawManifest =
            await loadRawManifest(
                modelId
            );

        state.manifest =
            normalizeManifest(
                rawManifest
            );

        state.files =
            state.manifest.files;

        if (
            !preserveSelection
        ) {

            state.region =
                null;

            state.product =
                null;

            state.forecastHour =
                null;

            state.frameIndex =
                0;
        }

        populateRegions();

        populateProducts();

        updateSelectionFiles();

        updateHeader();

        renderCurrentFrame();

    }

    catch (
        error
    ) {

        console.error(
            error
        );

        state.manifest =
            null;

        state.files =
            [];

        state.selectionFiles =
            [];

        state.region =
            null;

        state.product =
            null;

        state.forecastHour =
            null;

        state.frameIndex =
            0;

        modelText.textContent =
            getDisplayModelName();

        cycleText.textContent =
            "Cycle unavailable";

        availabilityBadge.textContent =
            "Unavailable";

        availabilityBadge.className =
            "availability-badge unavailable";

        regionSelect.innerHTML =
            "";

        productSelect.innerHTML =
            "";

        renderNoData(
            (
                getDisplayModelName()
                +
                " does not have a published cycle available yet."
            )
        );
    }
}


async function refreshCurrentModel() {

    if (
        state.cycleId
        !==
        "latest"
    ) {

        return;
    }

    const previousCycle =
        state.manifest?.cycle
        ??
        state.manifest?.cycle_id
        ??
        null;

    const previousStatus =
        state.manifest?.status
        ??
        null;

    const previousRegion =
        state.region;

    const previousProduct =
        state.product;

    const previousHour =
        state.forecastHour;

    const previousCurrentFile =
        (
            state.selectionFiles
            &&
            state.selectionFiles.length
            >
            0
        )
            ?
            state.selectionFiles[
                state.frameIndex
            ]
            :
            null;

    /*
     * A file fingerprint is more reliable than comparing only
     * manifest length.
     *
     * It detects:
     * - new forecast hours
     * - newly completed regions
     * - product cadence changes
     * - URL/object changes
     *
     * even when total file count happens to remain unchanged.
     */
    const previousFingerprint =
        state.files
            .map(
                file =>
                    [
                        file.region,
                        file.product,
                        Number(
                            file.forecast_hour
                        ),
                        file.url,
                    ].join(
                        "|"
                    )
            )
            .sort()
            .join(
                "\n"
            );

    try {

        const rawManifest =
            await loadRawManifest(
                state.modelId
            );

        const refreshed =
            normalizeManifest(
                rawManifest
            );

        const refreshedCycle =
            refreshed.cycle
            ??
            refreshed.cycle_id
            ??
            null;

        const refreshedStatus =
            refreshed.status
            ??
            null;

        const refreshedFingerprint =
            refreshed.files
                .map(
                    file =>
                        [
                            file.region,
                            file.product,
                            Number(
                                file.forecast_hour
                            ),
                            file.url,
                        ].join(
                            "|"
                        )
                )
                .sort()
                .join(
                    "\n"
                );

        const changed =
            (
                refreshedCycle
                !==
                previousCycle
            )
            ||
            (
                refreshedStatus
                !==
                previousStatus
            )
            ||
            (
                refreshedFingerprint
                !==
                previousFingerprint
            );

        if (
            !changed
        ) {

            return;
        }

        state.manifest =
            refreshed;

        state.files =
            refreshed.files;

        state.region =
            previousRegion;

        state.product =
            previousProduct;

        state.forecastHour =
            previousHour;

        /*
         * Keep the user's selected region/product whenever they
         * still exist in the newly refreshed manifest.
         */
        populateRegions();

        populateProducts();

        updateSelectionFiles();

        updateHeader();

        /*
         * Determine whether the actual displayed map changed.
         *
         * If only NEW forecast hours were added after the user's
         * current frame, do not reload their current PNG.
         * Just extend the timeline quietly.
         */
        const currentFile =
            (
                state.selectionFiles
                &&
                state.selectionFiles.length
                >
                0
            )
                ?
                state.selectionFiles[
                    state.frameIndex
                ]
                :
                null;

        const displayedFrameChanged =
            (
                !previousCurrentFile
            )
            ||
            (
                !currentFile
            )
            ||
            (
                Number(
                    previousCurrentFile.forecast_hour
                )
                !==
                Number(
                    currentFile.forecast_hour
                )
            )
            ||
            (
                previousCurrentFile.url
                !==
                currentFile.url
            )
            ||
            (
                previousCurrentFile.product
                !==
                currentFile.product
            )
            ||
            (
                previousCurrentFile.region
                !==
                currentFile.region
            )
            ||
            (
                refreshedCycle
                !==
                previousCycle
            );

        if (
            displayedFrameChanged
        ) {

            renderCurrentFrame();

            return;
        }

        /*
         * The user's map did not change, but the manifest did.
         *
         * Update controls without forcing the image to flash/reload.
         */
        updateFrameInformation();

        updateNavigationButtons();

        syncForecastScrubber();

        renderHourGrid();
    }

    catch (
        error
    ) {

        console.debug(
            "Background manifest refresh failed:",
            error
        );
    }
}


