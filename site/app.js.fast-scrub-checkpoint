/* ==========================================================
 * LATEST-CYCLE LOCK
 *
 * When the viewer is using "Latest", current.json is the
 * authoritative cycle pointer.
 *
 * This prevents an older archive/backfill cycle (for example
 * 18z) from temporarily relabeling Latest after current.json
 * has already advanced to 00z.
 * ========================================================== */

let masswxLatestCycleLockBusy = false;


function masswxFormatCycleLabel(
    payload
) {

    if (
        !payload
        ||
        !payload.cycle_date
    ) {
        return null;
    }

    const date =
        String(
            payload.cycle_date
        );

    const hour =
        Number(
            payload.cycle_hour
            ?? 0
        );

    if (date.length !== 8) {
        return null;
    }

    return (
        "Latest — "
        +
        date.slice(0, 4)
        +
        "-"
        +
        date.slice(4, 6)
        +
        "-"
        +
        date.slice(6, 8)
        +
        " "
        +
        String(hour).padStart(2, "0")
        +
        "z"
    );
}


async function masswxLockLatestCycle() {

    if (masswxLatestCycleLockBusy) {
        return;
    }

    const modelSelect =
        document.getElementById(
            "modelSelect"
        );

    const cycleSelect =
        document.getElementById(
            "cycleSelect"
        );

    if (
        !modelSelect
        ||
        !cycleSelect
    ) {
        return;
    }


    const modelId =
        modelSelect.value;


    /*
     * Apply to every operational model, but this immediately
     * fixes tonight's GFS 18z/00z oscillation.
     */

    if (!modelId) {
        return;
    }


    /*
     * Treat the first cycle option / explicit "latest" option
     * as Latest mode.
     */

    const selectedOption =
        cycleSelect.options[
            cycleSelect.selectedIndex
        ];


    const selectedValue =
        String(
            cycleSelect.value
            ?? ""
        ).toLowerCase();


    const selectedText =
        String(
            selectedOption?.textContent
            ?? ""
        ).toLowerCase();


    const latestMode = (
        selectedValue === "latest"
        ||
        selectedValue.startsWith("latest")
        ||
        selectedText.startsWith("latest")
        ||
        cycleSelect.selectedIndex === 0
    );


    if (!latestMode) {
        return;
    }


    masswxLatestCycleLockBusy = true;


    try {

        const response =
            await fetch(
                "/metadata/"
                +
                encodeURIComponent(
                    modelId
                )
                +
                "/current.json?ts="
                +
                Date.now(),
                {
                    cache: "no-store",
                }
            );


        if (!response.ok) {
            return;
        }


        const payload =
            await response.json();


        const cycleId =
            payload.cycle;


        const label =
            masswxFormatCycleLabel(
                payload
            );


        if (
            !cycleId
            ||
            !label
        ) {
            return;
        }


        /*
         * Find the Latest option. Normally this is the first
         * option, but don't rely exclusively on its position.
         */

        let latestOption = null;


        for (
            const option
            of cycleSelect.options
        ) {

            const value =
                String(
                    option.value
                    ?? ""
                ).toLowerCase();


            const text =
                String(
                    option.textContent
                    ?? ""
                ).toLowerCase();


            if (
                value === "latest"
                ||
                value.startsWith(
                    "latest"
                )
                ||
                text.startsWith(
                    "latest"
                )
            ) {

                latestOption =
                    option;

                break;
            }
        }


        if (!latestOption) {
            latestOption =
                cycleSelect.options[0];
        }


        if (latestOption) {

            /*
             * Preserve whatever sentinel value the existing
             * application uses for Latest. Change only its
             * displayed label.
             */

            latestOption.textContent =
                label;


            /*
             * If Latest is currently selected, force the
             * selector back onto that option if another
             * asynchronous archive refresh moved it.
             */

            if (
                cycleSelect.selectedIndex
                !==
                latestOption.index
            ) {

                cycleSelect.selectedIndex =
                    latestOption.index;
            }
        }


        /*
         * Correct the top cycle display as well.
         */

        const cycleText =
            document.getElementById(
                "cycleText"
            );


        if (cycleText) {

            cycleText.textContent =
                "Cycle: "
                +
                cycleId;
        }

    }
    catch (error) {

        console.warn(
            "Latest-cycle lock:",
            error
        );

    }
    finally {

        masswxLatestCycleLockBusy =
            false;
    }
}


/*
 * Run immediately and keep Latest synchronized while a new
 * operational cycle is filling.
 */

masswxLockLatestCycle();

setInterval(
    masswxLockLatestCycle,
    5000
);



/* ==========================================================
 * GFS AUTHORITATIVE LATEST-CYCLE PROBE
 *
 * Do not rely exclusively on metadata/gfs/current.json while
 * an older backfill cycle can still overwrite that pointer.
 *
 * Instead:
 *   1. build recent 6-hour synoptic-cycle candidates
 *   2. probe each cycle's progress.json
 *   3. use the newest cycle that actually contains GFS data
 *   4. keep the "Latest" dropdown label locked to that cycle
 *
 * This is frontend-only and does not affect the GFS pipeline.
 * ========================================================== */

let masswxAuthoritativeGfsCycle = null;
let masswxGfsLatestProbeBusy = false;


function masswxGfsCycleId(
    date
) {
    const year =
        date.getUTCFullYear();

    const month =
        String(
            date.getUTCMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        String(
            date.getUTCDate()
        ).padStart(
            2,
            "0"
        );

    const hour =
        String(
            date.getUTCHours()
        ).padStart(
            2,
            "0"
        );

    return (
        `${year}${month}${day}_${hour}z`
    );
}


function masswxRecentGfsCycles() {

    const now =
        new Date();

    /*
     * Floor current UTC time to the nearest synoptic cycle.
     */

    const cycleHour =
        Math.floor(
            now.getUTCHours() / 6
        ) * 6;

    const base =
        new Date(
            Date.UTC(
                now.getUTCFullYear(),
                now.getUTCMonth(),
                now.getUTCDate(),
                cycleHour,
                0,
                0,
                0
            )
        );


    const cycles = [];


    /*
     * Probe the current synoptic cycle plus the previous
     * seven cycles. Newest is always first.
     */

    for (
        let offset = 0;
        offset < 8;
        offset += 1
    ) {

        const candidate =
            new Date(
                base.getTime()
                -
                offset
                *
                6
                *
                60
                *
                60
                *
                1000
            );


        cycles.push({
            id:
                masswxGfsCycleId(
                    candidate
                ),

            date:
                candidate,
        });
    }


    return cycles;
}


async function masswxProbeGfsCycle(
    cycle
) {

    const url =
        "/metadata/gfs/"
        +
        encodeURIComponent(
            cycle.id
        )
        +
        "/progress.json?ts="
        +
        Date.now();


    try {

        const response =
            await fetch(
                url,
                {
                    cache: "no-store",
                }
            );


        if (!response.ok) {
            return null;
        }


        const payload =
            await response.json();


        const hours =
            payload.available_forecast_hours
            ||
            payload.forecast_hours
            ||
            [];


        const fileCount =
            Number(
                payload.file_count
                ??
                0
            );


        /*
         * Require actual output, not merely the existence of
         * an empty metadata object.
         */

        if (
            fileCount <= 0
            &&
            (
                !Array.isArray(hours)
                ||
                hours.length === 0
            )
        ) {
            return null;
        }


        return {
            cycle:
                cycle,

            payload:
                payload,
        };

    }
    catch (error) {

        return null;
    }
}


function masswxGfsLatestLabel(
    cycle
) {

    const date =
        cycle.date;


    const year =
        date.getUTCFullYear();

    const month =
        String(
            date.getUTCMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        String(
            date.getUTCDate()
        ).padStart(
            2,
            "0"
        );

    const hour =
        String(
            date.getUTCHours()
        ).padStart(
            2,
            "0"
        );


    return (
        `Latest — ${year}-${month}-${day} ${hour}z`
    );
}


function masswxFindLatestOption(
    cycleSelect
) {

    for (
        const option
        of cycleSelect.options
    ) {

        const text =
            String(
                option.textContent
                ??
                ""
            )
            .trim()
            .toLowerCase();


        const value =
            String(
                option.value
                ??
                ""
            )
            .trim()
            .toLowerCase();


        if (
            text.startsWith(
                "latest"
            )
            ||
            value === "latest"
            ||
            value.startsWith(
                "latest"
            )
        ) {

            return option;
        }
    }


    return (
        cycleSelect.options[0]
        ||
        null
    );
}


async function masswxUpdateAuthoritativeGfsLatest() {

    if (
        masswxGfsLatestProbeBusy
    ) {
        return;
    }


    const modelSelect =
        document.getElementById(
            "modelSelect"
        );

    const cycleSelect =
        document.getElementById(
            "cycleSelect"
        );


    if (
        !modelSelect
        ||
        !cycleSelect
        ||
        modelSelect.value
        !==
        "gfs"
    ) {
        return;
    }


    masswxGfsLatestProbeBusy =
        true;


    try {

        const candidates =
            masswxRecentGfsCycles();


        let newest =
            null;


        /*
         * Candidates are newest -> oldest.
         *
         * Stop at the first cycle that has real output.
         */

        for (
            const candidate
            of candidates
        ) {

            const found =
                await masswxProbeGfsCycle(
                    candidate
                );


            if (found) {

                newest =
                    found;

                break;
            }
        }


        if (!newest) {
            return;
        }


        masswxAuthoritativeGfsCycle =
            newest.cycle.id;


        const latestOption =
            masswxFindLatestOption(
                cycleSelect
            );


        if (latestOption) {

            latestOption.textContent =
                masswxGfsLatestLabel(
                    newest.cycle
                );
        }


        /*
         * If the viewer is currently in Latest mode, prevent
         * archive/current polling from visually moving the
         * selector back to an older cycle.
         */

        const selectedOption =
            cycleSelect.options[
                cycleSelect.selectedIndex
            ];


        const selectedText =
            String(
                selectedOption
                ?.textContent
                ??
                ""
            )
            .toLowerCase();


        const latestMode =
            selectedOption
            ===
            latestOption
            ||
            selectedText.startsWith(
                "latest"
            );


        if (
            latestMode
            &&
            latestOption
        ) {

            cycleSelect.selectedIndex =
                latestOption.index;
        }


        /*
         * Keep the header synchronized as well.
         */

        if (latestMode) {

            const cycleText =
                document.getElementById(
                    "cycleText"
                );


            if (cycleText) {

                cycleText.textContent =
                    "Cycle: "
                    +
                    masswxAuthoritativeGfsCycle;
            }
        }

    }
    finally {

        masswxGfsLatestProbeBusy =
            false;
    }
}


/*
 * Run immediately and periodically while the operational GFS
 * cycle is filling.
 */

masswxUpdateAuthoritativeGfsLatest();

setInterval(
    masswxUpdateAuthoritativeGfsLatest,
    5000
);



/* ==========================================================
 * GFS AUTHORITATIVE LATEST MANIFEST LOAD
 *
 * Tonight current.json can be temporarily demoted by an older
 * backfill cycle. When the authoritative GFS cycle probe has
 * found a newer cycle, load that cycle's progress.json directly
 * instead of following current.json.
 * ========================================================== */

const masswxOriginalLatestAwareLoadRawManifest =
    loadRawManifest;


loadRawManifest =
    async function (
        modelId
    ) {

        if (
            modelId === "gfs"
            &&
            masswxAuthoritativeGfsCycle
        ) {

            const authoritativeUrl =
                "/metadata/gfs/"
                +
                encodeURIComponent(
                    masswxAuthoritativeGfsCycle
                )
                +
                "/progress.json";


            try {

                const manifest =
                    await fetchJson(
                        authoritativeUrl
                    );


                if (
                    manifest
                    &&
                    (
                        manifest.cycle
                        ===
                        masswxAuthoritativeGfsCycle
                        ||
                        (
                            String(
                                manifest.cycle_date
                                ?? ""
                            )
                            +
                            "_"
                            +
                            String(
                                manifest.cycle_hour
                                ?? ""
                            )
                            .padStart(
                                2,
                                "0"
                            )
                            +
                            "z"
                        )
                        ===
                        masswxAuthoritativeGfsCycle
                    )
                ) {

                    return manifest;
                }

            }
            catch (
                error
            ) {

                console.debug(
                    "Authoritative GFS manifest "
                    + "not available yet:",
                    masswxAuthoritativeGfsCycle,
                    error
                );
            }
        }


        return (
            masswxOriginalLatestAwareLoadRawManifest(
                modelId
            )
        );
    };


/* ==========================================================
 * FORCE ONE RELOAD WHEN AUTHORITATIVE GFS CYCLE CHANGES
 * ========================================================== */

let masswxLoadedAuthoritativeGfsCycle =
    null;


async function masswxSyncAuthoritativeGfsViewer() {

    if (
        state.modelId !== "gfs"
        ||
        !masswxAuthoritativeGfsCycle
    ) {
        return;
    }


    if (
        masswxLoadedAuthoritativeGfsCycle
        ===
        masswxAuthoritativeGfsCycle
    ) {
        return;
    }


    masswxLoadedAuthoritativeGfsCycle =
        masswxAuthoritativeGfsCycle;


    /*
     * Set the real viewer state before loading.
     */

    state.cycleId =
        masswxAuthoritativeGfsCycle;


    try {

        await loadModel(
            "gfs"
        );

        console.log(
            "GFS Latest loaded authoritative cycle:",
            masswxAuthoritativeGfsCycle
        );

    }
    catch (
        error
    ) {

        /*
         * Allow a later retry if the cycle manifest was still
         * being written at this exact moment.
         */

        masswxLoadedAuthoritativeGfsCycle =
            null;

        console.warn(
            "GFS authoritative cycle reload failed:",
            error
        );
    }
}


/*
 * The existing GFS probe runs every 5 seconds.
 * Give it a moment to resolve the latest cycle, then sync the
 * actual viewer state/data to that resolved cycle.
 */

setInterval(
    masswxSyncAuthoritativeGfsViewer,
    2000
);

