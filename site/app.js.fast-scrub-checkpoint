document.addEventListener(
    "keydown",
    event => {

        const target =
            event.target;

        if (
            target
            &&
            (
                target.tagName
                ===
                "INPUT"
                ||
                target.tagName
                ===
                "SELECT"
                ||
                target.tagName
                ===
                "TEXTAREA"
            )
        ) {

            return;
        }

        if (
            event.key
            ===
            "ArrowLeft"
        ) {

            event.preventDefault();

            stopAnimation();

            previousFrame();
        }

        else if (
            event.key
            ===
            "ArrowRight"
        ) {

            event.preventDefault();

            stopAnimation();

            nextFrame();
        }

        else if (
            event.code
            ===
            "Space"
        ) {

            event.preventDefault();

            toggleAnimation();
        }
    }
);


